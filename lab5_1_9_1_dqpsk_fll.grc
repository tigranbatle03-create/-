options:
  parameters: {author: Lab5, catch_exceptions: 'True', category: '[GRC Hier Blocks]', cmake_opt: '', comment: '', copyright: '', description: '', gen_cmake: 'On', gen_linking: dynamic, generate_options: qt_gui,
    hier_block_src_path: '.:', id: lab5_1_9_1_dqpsk_fll, max_nouts: '0', output_language: python, placement: '(0,0)', qt_qss_theme: '', realtime_scheduling: '', run: 'True', run_command: '{python} -u {filename}',
    run_options: prompt, sizing_mode: fixed, thread_safe_setters: '', title: 'ЛР5 п.1.9.1  DQPSK: без АПЧ / с FLL Band-Edge', window_size: '(1000,1000)'}
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 8]
    rotation: 0
    state: enabled
blocks:
- name: samp_rate
  id: variable
  parameters: {comment: '', value: 2e6}
  states:
    coordinate: [200, 12]
    rotation: 0
    state: enabled
- name: sps
  id: variable
  parameters: {comment: '', value: '10'}
  states:
    coordinate: [300, 12]
    rotation: 0
    state: enabled
- name: alpha
  id: variable
  parameters: {comment: '', value: '0.35'}
  states:
    coordinate: [390, 12]
    rotation: 0
    state: enabled
- name: Rs
  id: variable
  parameters: {comment: '', value: samp_rate/sps}
  states:
    coordinate: [480, 12]
    rotation: 0
    state: enabled
- name: dqpsk
  id: variable_constellation
  parameters: {sym_map: '[0, 1, 2, 3]', const_points: '[1, 1j, -1, -1j]', rot_sym: '4', dims: '1', normalization: digital.constellation.AMPLITUDE_NORMALIZATION, precision: '8', npwr: '1.0', soft_dec_lut: None,
    affinity: '', alias: '', maxoutbuf: '0', minoutbuf: '0', comment: '', type: calcdist}
  states:
    coordinate: [950, 12]
    rotation: 0
    state: enabled
- name: n
  id: variable_qtgui_range
  parameters: {rangeType: float, value: '0', start: '0', stop: '1000', step: '1', widget: counter_slider, orient: QtCore.Qt.Horizontal, min_len: '200', affinity: '', alias: '', maxoutbuf: '0', minoutbuf: '0',
    comment: '', label: '"Noise Voltage, мВ"'}
  states:
    coordinate: [680, 12]
    rotation: 0
    state: enabled
- name: f
  id: variable_qtgui_range
  parameters: {rangeType: float, value: '0', start: '-50000.0', stop: '50000.0', step: '100', widget: counter_slider, orient: QtCore.Qt.Horizontal, min_len: '200', affinity: '', alias: '', maxoutbuf: '0',
    minoutbuf: '0', comment: '', label: '"Расстройка частоты, Гц"'}
  states:
    coordinate: [800, 90]
    rotation: 0
    state: enabled
- name: src
  id: analog_random_uniform_source_x
  parameters: {seed: '0', affinity: '', alias: '', maxoutbuf: '0', minoutbuf: '0', comment: '', type: byte, minimum: '0', maximum: '4'}
  states:
    coordinate: [8, 160]
    rotation: 0
    state: enabled
- name: blocks_throttle2_0
  id: blocks_throttle2
  parameters: {samples_per_second: Rs, vlen: '1', ignoretag: 'True', maximum: '0.1', affinity: '', alias: '', maxoutbuf: '0', minoutbuf: '0', comment: '', type: byte}
  states:
    coordinate: [8, 280]
    rotation: 0
    state: enabled
- name: diff_enc
  id: digital_diff_encoder_bb
  parameters: {coding: digital.DIFF_DIFFERENTIAL, affinity: '', alias: '', maxoutbuf: '0', minoutbuf: '0', comment: '', modulus: '4'}
  states:
    coordinate: [200, 280]
    rotation: 0
    state: enabled
- name: chunks2sym
  id: digital_chunks_to_symbols_xx
  parameters: {dimension: '1', num_ports: '1', affinity: '', alias: '', maxoutbuf: '0', minoutbuf: '0', comment: '', in_type: byte, out_type: complex, symbol_table: '[0.707+0.707j, -0.707+0.707j, -0.707-0.707j,
      0.707-0.707j]'}
  states:
    coordinate: [400, 270]
    rotation: 0
    state: enabled
- name: rrc_tx
  id: interp_fir_filter_xxx
  parameters: {interp: sps, samp_delay: '0', affinity: '', alias: '', maxoutbuf: '0', minoutbuf: '0', comment: '', type: ccf, taps: 'firdes.root_raised_cosine(sps, sps, 1.0, alpha, 11*sps)'}
  states:
    coordinate: [620, 270]
    rotation: 0
    state: enabled
- name: channel
  id: channels_channel_model
  parameters: {noise_voltage: n*1e-3, freq_offset: f/samp_rate, epsilon: '1.0', taps: '1.0', seed: '0', block_tags: 'False', affinity: '', alias: '', maxoutbuf: '0', minoutbuf: '0', comment: ''}
  states:
    coordinate: [820, 230]
    rotation: 0
    state: enabled
- name: vsink
  id: virtual_sink
  parameters: {comment: '', stream_id: dqpsk}
  states:
    coordinate: [1060, 260]
    rotation: 0
    state: enabled
- name: blocks_uchar_to_float_0
  id: blocks_uchar_to_float
  parameters: {affinity: '', alias: '', maxoutbuf: '0', minoutbuf: '0', comment: ''}
  states:
    coordinate: [200, 160]
    rotation: 0
    state: enabled
- name: qtgui_time_sink_x_0
  id: qtgui_time_sink_x
  parameters: {type: float, name: '"Переданное"', ylabel: Amplitude, yunit: '""', size: '100', srate: Rs, grid: 'True', autoscale: 'False', ymin: '-1', ymax: '4', nconnections: '1', update_time: '0.10',
    entags: 'True', tr_mode: qtgui.TRIG_MODE_FREE, tr_slope: qtgui.TRIG_MODE_POS, tr_level: '0.0', tr_delay: '0', tr_chan: '0', tr_tag: '""', ctrlpanel: 'False', legend: 'True', axislabels: 'True', stemplot: 'False',
    label1: Signal 1, width1: '1', color1: blue, style1: '1', marker1: '-1', alpha1: '1.0', affinity: '', alias: '', maxoutbuf: '0', minoutbuf: '0', comment: ''}
  states:
    coordinate: [380, 120]
    rotation: 0
    state: enabled
- name: vsrc
  id: virtual_source
  parameters: {comment: '', stream_id: dqpsk}
  states:
    coordinate: [8, 480]
    rotation: 0
    state: enabled
- name: fll
  id: digital_fll_band_edge_cc
  parameters: {affinity: '', alias: '', maxoutbuf: '0', minoutbuf: '0', comment: '', type: cc, samps_per_sym: sps, rolloff: alpha, filter_size: '44', w: '0.00628'}
  states:
    coordinate: [200, 600]
    rotation: 0
    state: enabled
- name: qtgui_freq_sink_x_0
  id: qtgui_freq_sink_x
  parameters: {type: complex, name: '"Спектр: до FLL / после FLL"', fftsize: '4096', freqhalf: 'True', wintype: window.WIN_BLACKMAN_hARRIS, norm_window: 'False', fc: '0', bw: samp_rate, grid: 'True', autoscale: 'False',
    average: '0.1', ymin: '-100', ymax: '10', label: Relative Gain, units: dB, nconnections: '2', update_time: '0.10', showports: 'False', tr_mode: qtgui.TRIG_MODE_FREE, tr_level: '0.0', tr_chan: '0', tr_tag: '""',
    ctrlpanel: 'False', legend: 'True', axislabels: 'True', width1: '1', alpha1: '1.0', affinity: '', alias: '', maxoutbuf: '0', minoutbuf: '0', comment: ''}
  states:
    coordinate: [200, 380]
    rotation: 0
    state: enabled
- name: qtgui_const_sink_x_0
  id: qtgui_const_sink_x
  parameters: {type: complex, name: '"После Differential Phasor: без FLL / с FLL"', size: '1024', grid: 'True', autoscale: 'False', ymin: '-1.5', ymax: '1.5', xmin: '-1.5', xmax: '1.5', nconnections: '2',
    update_time: '0.10', tr_mode: qtgui.TRIG_MODE_FREE, tr_slope: qtgui.TRIG_MODE_POS, tr_level: '0.0', tr_chan: '0', tr_tag: '""', legend: 'True', axislabels: 'True', width1: '1', alpha1: '1.0', affinity: '',
    alias: '', maxoutbuf: '0', minoutbuf: '0', comment: ''}
  states:
    coordinate: [1100, 520]
    rotation: 0
    state: enabled
- name: qtgui_time_sink_x_1
  id: qtgui_time_sink_x
  parameters: {type: float, name: '"Принятое: без FLL / с FLL"', ylabel: Amplitude, yunit: '""', size: '100', srate: Rs, grid: 'True', autoscale: 'False', ymin: '-1', ymax: '4', nconnections: '2', update_time: '0.10',
    entags: 'True', tr_mode: qtgui.TRIG_MODE_FREE, tr_slope: qtgui.TRIG_MODE_POS, tr_level: '0.0', tr_delay: '0', tr_chan: '0', tr_tag: '""', ctrlpanel: 'False', legend: 'True', axislabels: 'True', stemplot: 'False',
    label1: Signal 1, width1: '1', color1: blue, style1: '1', marker1: '-1', alpha1: '1.0', affinity: '', alias: '', maxoutbuf: '0', minoutbuf: '0', comment: ''}
  states:
    coordinate: [1100, 700]
    rotation: 0
    state: enabled
- name: symsync_a
  id: digital_symbol_sync_xx
  parameters: {constellation: digital.constellation_qpsk().base(), sps: sps, ted_gain: '1.0', loop_bw: '0.045', damping: '1.0', max_dev: '1.5', osps: '1', nfilters: '128', pfb_mf_taps: 'firdes.root_raised_cosine(128,
      128*sps, 1.0, alpha, 11*sps*128)', affinity: '', alias: '', maxoutbuf: '0', minoutbuf: '0', comment: '', type: cc, ted_type: digital.TED_GARDNER, resamp_type: digital.IR_PFB_MF}
  states:
    coordinate: [430, 480]
