    update_time: '0.10', tr_mode: qtgui.TRIG_MODE_FREE, tr_slope: qtgui.TRIG_MODE_POS, tr_level: '0.0', tr_chan: '0', tr_tag: '""', legend: 'True', axislabels: 'True', width1: '1', alpha1: '1.0', affinity: '',
