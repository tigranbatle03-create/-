options:
  parameters: {author: Lab5, catch_exceptions: 'True', category: '[GRC Hier Blocks]', cmake_opt: '', comment: '', copyright: '', description: '', gen_cmake: 'On', gen_linking: dynamic, generate_options: qt_gui,
    hier_block_src_path: '.:', id: lab5_1_9_1_dqpsk_heterodyne, max_nouts: '0', output_language: python, placement: '(0,0)', qt_qss_theme: '', realtime_scheduling: '', run: 'True', run_command: '{python}
      -u {filename}', run_options: prompt, sizing_mode: fixed, thread_safe_setters: '', title: 'ЛР5 п.1.9.1  DQPSK: компенсация расстройки гетеродином', window_size: '(1000,1000)'}
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 8]
    rotation: 0
    state: enabled
blocks:
- name: samp_rate
  id: variable
  parameters: {comment: '', value: 2e6}
  states:
    coordinate: [200, 12]
    rotation: 0
    state: enabled
- name: src
