  parameters: {vector: '(0, 1, 2, 3)', tags: '[]', repeat: 'True', vlen: '1', affinity: '', alias: '', maxoutbuf: '0', minoutbuf: '0', comment: '', type: byte}
  states:
    coordinate: [8, 180]
    rotation: 0
    state: enabled
- name: blocks_throttle2_0
  id: blocks_throttle2
  parameters: {samples_per_second: samp_rate, vlen: '1', ignoretag: 'True', maximum: '0.1', affinity: '', alias: '', maxoutbuf: '0', minoutbuf: '0', comment: '', type: byte}
  states:
    coordinate: [8, 300]
    rotation: 0
    state: enabled
- name: blocks_uchar_to_float_0
  id: blocks_uchar_to_float
  parameters: {affinity: '', alias: '', maxoutbuf: '0', minoutbuf: '0', comment: ''}
  states:
    coordinate: [300, 100]
    rotation: 0
    state: enabled
- name: qtgui_time_sink_x_0
  id: qtgui_time_sink_x
  parameters: {type: float, name: '"Переданное"', ylabel: Amplitude, yunit: '""', size: '100', srate: samp_rate, grid: 'True', autoscale: 'True', ymin: '-1', ymax: '4', nconnections: '1', update_time: '0.10',
    entags: 'True', tr_mode: qtgui.TRIG_MODE_FREE, tr_slope: qtgui.TRIG_MODE_POS, tr_level: '0.0', tr_delay: '0', tr_chan: '0', tr_tag: '""', ctrlpanel: 'False', legend: 'True', axislabels: 'True', stemplot: 'False',
    label1: Signal 1, width1: '1', color1: blue, style1: '1', marker1: '-1', alpha1: '1.0', affinity: '', alias: '', maxoutbuf: '0', minoutbuf: '0', comment: ''}
  states:
    coordinate: [500, 60]
    rotation: 0
    state: enabled
- name: diff_enc
  id: digital_diff_encoder_bb
  parameters: {coding: digital.DIFF_DIFFERENTIAL, affinity: '', alias: '', maxoutbuf: '0', minoutbuf: '0', comment: '', modulus: '4'}
  states:
    coordinate: [250, 260]
    rotation: 0
    state: enabled
- name: chunks2sym
  id: digital_chunks_to_symbols_xx
  parameters: {dimension: '1', num_ports: '1', affinity: '', alias: '', maxoutbuf: '0', minoutbuf: '0', comment: '', in_type: byte, out_type: complex, symbol_table: '[0.707+0.707j, -0.707+0.707j, -0.707-0.707j,
      0.707-0.707j]'}
  states:
    coordinate: [470, 250]
    rotation: 0
    state: enabled
- name: n
  id: variable_qtgui_range
  parameters: {rangeType: float, value: '0', start: '0', stop: '1000', step: '1', widget: counter_slider, orient: QtCore.Qt.Horizontal, min_len: '200', affinity: '', alias: '', maxoutbuf: '0', minoutbuf: '0',
    comment: '', label: '"Noise Voltage, мВ"'}
  states:
    coordinate: [150, 470]
    rotation: 0
    state: enabled
- name: f
  id: variable_qtgui_range
  parameters: {rangeType: float, value: '0', start: '-10000.0', stop: '10000.0', step: '10', widget: counter_slider, orient: QtCore.Qt.Horizontal, min_len: '200', affinity: '', alias: '', maxoutbuf: '0',
    minoutbuf: '0', comment: '', label: '"Расстройка частоты, Гц"'}
  states:
